# Copie para .env e preencha (nunca commite o ficheiro .env)

# URL do projeto Supabase (pública no cliente)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anon/public (pública no cliente; proteção via RLS no Postgres)
VITE_SUPABASE_ANON_KEY=sua_chave_anon

# PROIBIDO no frontend — configure apenas no Supabase Dashboard → Edge Functions:
# SUPABASE_SERVICE_ROLE_KEY=...
